#!/bin/sh

wait_seconds="${1:-30}"

framebuffer_is_ready() {
    [ -c /dev/fb0 ]
}

network_is_ready() {
    ip -4 address show 2>/dev/null | grep "inet " | grep -qv "127.0.0.1"
}

mqtt_broker_is_ready() {
    systemctl is-active --quiet mosquitto.service
}

waited_seconds=0
while [ "$waited_seconds" -lt "$wait_seconds" ]; do
    if framebuffer_is_ready && network_is_ready && mqtt_broker_is_ready; then
        exit 0
    fi

    sleep 1
    waited_seconds=$((waited_seconds + 1))
done

# The application cannot draw without a framebuffer. Returning an error makes
# systemd retry the service because the unit uses Restart=on-failure.
if ! framebuffer_is_ready; then
    echo "Framebuffer /dev/fb0 is not ready after ${wait_seconds} seconds" >&2
    exit 1
fi

# Network access is optional. IoT App can show its offline dashboard and the
# MQTT client will reconnect when the broker becomes available.
exit 0
