#!/bin/sh

# Prepare the optional persistent data partition used by the Buildroot and
# Yocto images. Buildroot calls this program from S25data-storage. Yocto calls
# it from iot-app-storage.service before starting IoT App.
#
# The generated SD-card image contains these partitions:
#
#   Partition 1: Raspberry Pi boot files
#   Partition 2: Linux root filesystem
#   Partition 3: small ext4 filesystem labelled iot-data
#
# The third partition is kept small in the generated image so the image is
# quick to build, copy, and flash. On the first boot, this program extends that
# partition to the end of the SD card, grows its ext4 filesystem, and mounts it
# at /data. Files stored there remain available after a reboot.
#
# It also creates /data/iot-app/development. The IoT App launcher checks that
# directory for a development executable before using /usr/bin/iot_app.
#
# IoT App can run without this partition. If partition 3 is absent, this
# program leaves /data unavailable and exits successfully. The launcher then
# uses /usr/bin/iot_app.
#
# The program is safe to run on later boots. If /data is already mounted, it
# only checks the application directories and their ownership.
#
# Command references:
# https://man7.org/linux/man-pages/man5/proc_cmdline.5.html
# https://www.gnu.org/software/parted/manual/html_node/resizepart.html
# https://man7.org/linux/man-pages/man8/partx.8.html
# https://man7.org/linux/man-pages/man8/resize2fs.8.html

# Report an unset shell variable as an error instead of treating it as empty.
set -u

data_mount_point="/data"
development_directory="/data/iot-app/development"
expected_data_label="iot-data"

# Check the programs used below before making any changes to the partition.
# A missing program leaves /data unavailable, but it does not stop IoT App
# because the storage startup job is an optional dependency.
check_required_commands() {
	for required_command in awk e2label mkdir chmod id chown parted partx resize2fs mount; do
		if ! command -v "$required_command" >/dev/null 2>&1; then
			echo "Cannot prepare optional data storage because $required_command is not installed" >&2
			return 1
		fi
	done
}

# Read root= from the kernel command line to find the storage device that
# contains the running image. This project always puts Linux in partition 2
# and persistent data in partition 3.
#
# Device names use different partition formats. An SD card or NVMe device has
# names such as /dev/mmcblk0p2 or /dev/nvme0n1p2. USB and virtual disks use
# names such as /dev/sda2 or /dev/vda2.
find_image_devices() {
	root_device=""
	for kernel_argument in $(cat /proc/cmdline); do
		case "$kernel_argument" in
			root=*)
				root_device="${kernel_argument#root=}"
				;;
		esac
	done

	case "$root_device" in
		/dev/mmcblk*p2|/dev/nvme*n*p2)
			image_device="${root_device%p2}"
			data_partition="${image_device}p3"
			;;
		/dev/sd*2|/dev/vd*2)
			image_device="${root_device%2}"
			data_partition="${image_device}3"
			;;
		*)
			echo "Cannot find the image device from root=$root_device" >&2
			return 1
			;;
	esac
}

# Return success only when the expected device is already mounted at /data.
# Checking /proc/mounts avoids trying to resize a filesystem while it is in
# use. It also makes repeated calls finish quickly after the first boot.
data_partition_is_mounted() {
	awk -v device="$data_partition" -v directory="$data_mount_point" \
		'$1 == device && $2 == directory { found = 1 } END { exit !found }' \
		/proc/mounts
}

# Create the directory used for development executables. The iot-app account
# owns /data and this directory because IoT App may store persistent files
# there. The id check keeps this shared helper safe if it is run on a system
# where that account has not been installed.
prepare_iot_app_directories() {
	if ! data_partition_is_mounted; then
		echo "Refusing to create application directories because $data_mount_point is not mounted" >&2
		return 1
	fi

	if ! mkdir -p "$development_directory"; then
		echo "Could not create $development_directory" >&2
		return 1
	fi
	if ! chmod 0755 "$development_directory"; then
		echo "Could not set permissions on $development_directory" >&2
		return 1
	fi

	if id iot-app >/dev/null 2>&1; then
		if ! chown iot-app:iot-app "$data_mount_point" "$development_directory"; then
			echo "Could not give the iot-app user access to $data_mount_point" >&2
			return 1
		fi
	fi
}

# An unsupported root-device name means this image has no data partition that
# this program can safely identify. IoT App can still run from its installed
# executable.
if ! find_image_devices; then
	echo "Optional persistent storage is unavailable; continuing without $data_mount_point"
	exit 0
fi

# A missing third partition is allowed. This can happen when the complete disk
# is assigned to the Linux root partition. Do not create /data directories on
# the root filesystem as a substitute.
if [ ! -b "$data_partition" ]; then
	echo "Optional data partition does not exist: $data_partition; continuing without $data_mount_point"
	exit 0
fi

check_required_commands || exit 1

# Verify the ext4 label before changing a partition boundary. This check keeps
# the script from resizing an unrelated third partition if it is run on a
# different disk layout.
if ! actual_data_label="$(e2label "$data_partition" 2>/dev/null)"; then
	echo "Could not read the filesystem label from $data_partition" >&2
	exit 1
fi
if [ "$actual_data_label" != "$expected_data_label" ]; then
	echo "Refusing to resize $data_partition because its label is '$actual_data_label', not '$expected_data_label'" >&2
	exit 1
fi

if data_partition_is_mounted; then
	prepare_iot_app_directories || exit 1
	exit 0
fi

# First extend partition 3 to the end of the device. Then tell the kernel about
# its new boundary and grow the ext4 filesystem inside it. Resizing the
# partition alone would not make the extra space available to files.
echo "Expanding $data_partition to use the remaining space on $image_device"
if ! parted --script "$image_device" resizepart 3 100%; then
	echo "Could not expand partition 3 on $image_device" >&2
	exit 1
fi
if ! partx --update --nr 3 "$image_device"; then
	echo "Could not update the kernel's partition information for $data_partition" >&2
	exit 1
fi
if ! resize2fs "$data_partition"; then
	echo "Could not expand the filesystem on $data_partition" >&2
	exit 1
fi

# Mount the expanded filesystem and finish preparing its application
# directories. The startup script or service that called this program manages
# the mount during the current boot.
if ! mkdir -p "$data_mount_point"; then
	echo "Could not create the mount point $data_mount_point" >&2
	exit 1
fi
if ! mount -t ext4 "$data_partition" "$data_mount_point"; then
	echo "Could not mount $data_partition at $data_mount_point" >&2
	exit 1
fi
if ! data_partition_is_mounted; then
	echo "$data_partition was not mounted at $data_mount_point" >&2
	exit 1
fi

prepare_iot_app_directories || exit 1
