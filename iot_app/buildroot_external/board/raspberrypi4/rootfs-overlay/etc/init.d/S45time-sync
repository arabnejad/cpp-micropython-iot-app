#!/bin/sh

DAEMON="/usr/sbin/ntpd"
PIDFILE="/var/run/ntpd.pid"

ntpd_is_running() {
	[ -r "$PIDFILE" ] || return 1
	ntpd_pid="$(cat "$PIDFILE")"
	[ -n "$ntpd_pid" ] && kill -0 "$ntpd_pid" 2>/dev/null
}

start() {
	printf "Starting network time synchronization: "
	if ntpd_is_running; then
		echo "already running"
		return 0
	fi
	rm -f "$PIDFILE"

	# Keep ntpd in foreground mode from its own point of view. The service
	# launcher puts it in the background, records its PID, and detaches it from
	# the console. Multiple servers give it alternatives if one is unavailable.
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$DAEMON" -- \
		-n \
		-p 0.pool.ntp.org \
		-p 1.pool.ntp.org \
		-p 2.pool.ntp.org
	status=$?
	if [ "$status" -ne 0 ]; then
		echo "FAIL"
		return "$status"
	fi

	# ntpd corrects the clock when a time server becomes reachable. Do not delay
	# the dashboard while the device is offline or synchronization is pending.
	echo "started; synchronization continues in the background"
}

stop() {
	printf "Stopping network time synchronization: "
	if ! ntpd_is_running; then
		rm -f "$PIDFILE"
		echo "not running"
		return 0
	fi

	start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --exec "$DAEMON"
	status=$?
	rm -f "$PIDFILE"
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
