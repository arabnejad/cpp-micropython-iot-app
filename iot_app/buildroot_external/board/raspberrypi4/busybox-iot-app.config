# This file is a BusyBox Kconfig fragment. Buildroot merges these choices into
# BusyBox's main configuration. "CONFIG_NAME=y" enables an option. A line such
# as "# CONFIG_NAME is not set" is Kconfig's normal way of explicitly turning
# an option off; it is not only an explanatory comment.

# Build the BusyBox ntpd applet and install it as /usr/sbin/ntpd. ntpd uses the
# Network Time Protocol to correct the Raspberry Pi clock after the network is
# available. /etc/init.d/S45time-sync starts it in the background and gives it
# three pool.ntp.org servers with -p options.
CONFIG_NTPD=y

# Use ntpd only as a client. IoT App needs to receive the correct time, but the
# Raspberry Pi does not need to provide time to other computers on the network.
# CONFIG_FEATURE_NTPD_SERVER is not set

# Do not read peers from /etc/ntp.conf. S45time-sync supplies each time server
# directly with a -p argument, so an additional configuration file is not
# needed.
# CONFIG_FEATURE_NTPD_CONF is not set

# Do not include BusyBox's MD5/SHA1 NTP message-authentication support. The
# public pool servers used by this image are not configured with shared NTP
# authentication keys.
# CONFIG_FEATURE_NTP_AUTH is not set
