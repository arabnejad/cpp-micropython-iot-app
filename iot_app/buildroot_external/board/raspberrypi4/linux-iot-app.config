# Linux features used by IoT App on Raspberry Pi 4.
#
# This is a Linux Kconfig fragment. Buildroot combines it with the Raspberry Pi
# kernel's main configuration before compiling Linux:
#
#   CONFIG_NAME=y   builds the feature directly into the kernel Image. It is
#                   available during early boot and cannot be unloaded.
#
#   CONFIG_NAME=m   builds the feature as a separate .ko kernel module under
#                   /lib/modules. mdev loads matching hardware modules through
#                   the $MODALIAS rule in /etc/mdev.conf. A startup script can
#                   also load one explicitly with modprobe.
#
#   # CONFIG_NAME is not set
#                   leaves the feature out of the kernel.
#
# Some options are Boolean switches and only accept y or "not set". When a
# Boolean option such as BRCMFMAC_SDIO is y under a parent driver set to m, its
# code is included inside that parent's module; it does not become a separate
# built-in driver. Kconfig can also reduce a requested y to m when one of the
# feature's required dependencies is a module.

# Provide the userspace I2C interface used by I2cDevice.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y

# Expose the VC4 display through DRM and framebuffer device /dev/fb0.
CONFIG_DRM=y
# VC4 depends on Raspberry Pi sound components which are modules in the base
# kernel configuration. It must therefore be a module as well. mdev loads it
# during hardware discovery before IoT App starts.
CONFIG_DRM_VC4=m
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Provide the Raspberry Pi GPU and video-decoder drivers used by mpv. V3D
# supplies accelerated graphics. The BCM2835 codec exposes hardware video
# decoding through Video4Linux's memory-to-memory API.
CONFIG_DRM_V3D=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_V4L2_MEM2MEM_DEV=m
CONFIG_VIDEO_CODEC_BCM2835=m

# Support the Raspberry Pi 4 onboard Wi-Fi adapter.
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
