# Linux features used by IoT App on Raspberry Pi 4.

# Provide the userspace I2C interface used by I2cDevice.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y

# Expose the VC4 display through DRM and framebuffer device /dev/fb0.
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Support the Raspberry Pi 4 onboard Wi-Fi adapter.
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
