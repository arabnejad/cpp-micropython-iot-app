#!/bin/sh

WAIT_SECONDS="${1:-30}"
MOSQUITTO_PIDFILE="/var/run/mosquitto.pid"

network_is_ready() {
	ip -4 address show 2>/dev/null | grep "inet " | grep -qv "127.0.0.1"
}

mqtt_broker_is_ready() {
	[ -r "$MOSQUITTO_PIDFILE" ] || return 1
	mosquitto_pid="$(cat "$MOSQUITTO_PIDFILE")"
	[ -n "$mosquitto_pid" ] && kill -0 "$mosquitto_pid" 2>/dev/null
}

waited_seconds=0
while [ "$waited_seconds" -lt "$WAIT_SECONDS" ]; do
	if network_is_ready && mqtt_broker_is_ready; then
		exit 0
	fi
	sleep 1
	waited_seconds=$((waited_seconds + 1))
done

# IoT App can still show an offline dashboard and reconnect to MQTT later.
exit 0
