config BR2_PACKAGE_IOT_APP
	bool "iot_app"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBDRM_VC4 if BR2_arm || BR2_aarch64
	help
	  Embedded C++ IoT App with a built-in MicroPython application,
	  native hardware modules, DRM display discovery, and LVGL Linux
	  framebuffer output.
